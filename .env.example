# Supabase 配置
# 需要在 https://supabase.com 创建新项目获取这些值
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Gemini AI 配置
GEMINI_API_KEY=your-gemini-api-key

# Aptabase Analytics 配置
# 需要在 https://aptabase.com 创建项目获取 App Key
VITE_APTABASE_APP_KEY=your-aptabase-app-key

# Vercel 特定环境变量（自动注入）
# VERCEL=1
# VERCEL_URL=your-vercel-domain.vercel.app